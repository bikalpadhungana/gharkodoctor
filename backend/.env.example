# Copy to backend/.env and fill in. Never commit the real file.
PORT=5004
# Set to "production" on the VPS: enables fail-fast DB, hides 5xx error details.
NODE_ENV=production
MONGODB_URI=mongodb://gharkodoctor_user:CHANGE_ME@127.0.0.1:27017/gharkodoctor?authSource=gharkodoctor
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d

# Comma-separated extra origins allowed by CORS (leave empty when the SPA is served by this server)
CORS_ORIGIN=

# SMS (Sparrow SMS or compatible token/from/to/text API). Empty = log only, nothing sent.
SMS_API_URL=https://api.sparrowsms.com/v2/sms/
SMS_API_KEY=
SMS_SENDER=

# Payments (not integrated yet — bookings currently collect payment at visit)
ESEWA_MERCHANT_ID=
KHALTI_SECRET_KEY=

# Seed admin (used by `npm run seed`). Use a strong password.
ADMIN_EMAIL=admin@gharkodoctor.com
ADMIN_PASSWORD=

# FlapMain IoT proxy (admin-only). Rotate the keys that were previously committed in source.
FLAPMAIN_SERVER=https://main.esainnovation.com/api
FLAPMAIN_ALLOWED_SERVERS=
FLAP_PARTNER_KEY=
FLAPMAIN_DEVICE_KEY=
